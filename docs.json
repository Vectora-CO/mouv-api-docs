{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mouv API",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#00E5A0",
    "light": "#5CFFD6",
    "dark": "#007A52"
  },
  "navbar": {
    "links": [
      {
        "label": "Contacto",
        "href": "mailto:hola@vectora.com.co"
      }
    ],
    "primary": {
